# This is an example environment file.
# Copy this file to a new file named .env.local and fill in your own keys.
# This .env.local file should NOT be committed to Git.

# Supabase keys can be found in your project's dashboard under Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Supabase service role key is a secret and should not be exposed on the client.
SUPABASE_SERVICE_ROLE_KEY=

# The Gemini API key for AI features. Get one from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash